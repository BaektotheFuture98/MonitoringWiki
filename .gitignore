# 원문 보고서(개인정보 포함)는 git에 넣지 않음. 서버 디스크에 두고 별도 백업.
raw/*
!raw/.gitkeep

# Python
server/.venv/
__pycache__/
*.egg-info/
.pytest_cache/

# 로컬 실행 확인용
.local-test/

# 작업 기록과 스냅샷(WIKI_STATE_DIR 기본 위치)
.state/

# 위키 패턴(운영 데이터). 원격 저장소에 올리지 않음
wiki/patterns/*.md

# 인프라 구성(클러스터 토폴로지). 형식 예시는 *.example.md만 커밋
wiki/infra/*.md
!wiki/infra/*.example.md

# 비밀값(API 키). 키 이름만 담은 server/.env.example만 커밋
.env

# 서버 로그(요청 내용·개인정보 포함 가능)
*.log
